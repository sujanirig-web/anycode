# Copy to .env and fill in, or export these in your shell.
# anycode itself does not read .env files; your shell or process manager must.

# Provider: anthropic | openai | openai-compatible | ollama
ANYCODE_PROVIDER=anthropic

# Model name for the selected provider.
ANYCODE_MODEL=claude-sonnet-4-5

# Optional: point at a proxy, gateway, or local server.
# ANYCODE_BASE_URL=http://localhost:11434/v1

# Optional: overrides the provider-specific key below.
# ANYCODE_API_KEY=

# Provider-specific keys (checked when ANYCODE_API_KEY is unset).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: keep config and rules out of your real home directory.
# ANYCODE_HOME=C:\path\to\anycode-home

# Set to 1 to disable colors (also honoured: --no-color).
# NO_COLOR=1
